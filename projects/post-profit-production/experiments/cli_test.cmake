execute_process(COMMAND "${PROGRAM}" --plan "${PLAN}"
  RESULT_VARIABLE run_code OUTPUT_VARIABLE run ERROR_VARIABLE run_error)
if(NOT run_code EQUAL 0)
  message(FATAL_ERROR "Experiment CLI failed: ${run_error}")
endif()
string(JSON schema GET "${run}" schema_version)
string(JSON status GET "${run}" status)
string(JSON runs LENGTH "${run}" runs)
if(NOT schema STREQUAL "production.experiment.v1" OR NOT status STREQUAL "ok" OR NOT runs EQUAL 102)
  message(FATAL_ERROR "Unexpected scheduling experiment report")
endif()
execute_process(COMMAND "${PROGRAM}" --plan "${PLAN}" --format markdown
  RESULT_VARIABLE markdown_code OUTPUT_VARIABLE markdown ERROR_VARIABLE markdown_error)
if(NOT markdown_code EQUAL 0 OR NOT markdown MATCHES "Production scheduling observations" OR NOT markdown MATCHES "unfinished")
  message(FATAL_ERROR "Markdown report failed: ${markdown_error}")
endif()
foreach(argument --unknown --format)
  execute_process(COMMAND "${PROGRAM}" "${argument}"
    RESULT_VARIABLE invalid_code OUTPUT_VARIABLE invalid_output ERROR_VARIABLE invalid_error)
  if(NOT invalid_code EQUAL 1 OR NOT invalid_output STREQUAL "")
    message(FATAL_ERROR "Invalid argument produced a report")
  endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --plan "${PLAN}" --format html
  RESULT_VARIABLE invalid_format OUTPUT_VARIABLE invalid_output)
if(NOT invalid_format EQUAL 1 OR NOT invalid_output STREQUAL "")
  message(FATAL_ERROR "Unsupported report format accepted")
endif()
file(READ "${PLAN}" plan_text)
string(JSON wrong_plan SET "${plan_text}" verification_cases 0 expectations fifo result summary completed_jobs 99)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/wrong-expectation.cfg" "${wrong_plan}")
execute_process(COMMAND "${PROGRAM}" --plan "${CMAKE_CURRENT_BINARY_DIR}/wrong-expectation.cfg"
  RESULT_VARIABLE failed_code OUTPUT_VARIABLE failed_report ERROR_VARIABLE failed_error)
if(NOT failed_code EQUAL 2)
  message(FATAL_ERROR "Failed verification did not return exit 2: ${failed_error}")
endif()
string(JSON failed_status GET "${failed_report}" status)
string(JSON skipped LENGTH "${failed_report}" skipped_cases)
string(JSON failed_runs LENGTH "${failed_report}" runs)
if(NOT failed_status STREQUAL "verification_failed" OR NOT skipped EQUAL 2 OR NOT failed_runs EQUAL 22)
  message(FATAL_ERROR "Verification gate did not retain controls and skip exploration")
endif()
